#!/bin/sh
# Sets the ownership and modes of the Kiestoon data directory. Run by the package scripts and after
# a restore (user and group IDs can differ between machines).
#
#   /var/lib/kiestoon            kiestoon:kiestoon 0751  database and settings (others may only pass through)
#   /var/lib/kiestoon/pbx        kiestoon:asterisk 2750  generated Asterisk configuration, readable by Asterisk
#   /var/lib/kiestoon/asterisk   asterisk:asterisk 2770  voicemail and recordings (the portal is in group asterisk)
#   /var/lib/kiestoon/mailq      asterisk:kiestoon 2770  voicemail e-mails waiting to be sent by the portal
set -e
DATA="${KIESTOON_DATA_DIR:-/var/lib/kiestoon}"

install -d -o kiestoon -g kiestoon -m 0751 "$DATA"
chown -R kiestoon:kiestoon "$DATA"
chmod 0751 "$DATA"
install -d -o kiestoon -g kiestoon -m 0700 "$DATA/staging"

if getent group asterisk >/dev/null; then
  install -d -o kiestoon -g asterisk -m 2750 "$DATA/pbx" "$DATA/pbx/tls"
  chown -R kiestoon:asterisk "$DATA/pbx"
  find "$DATA/pbx" -type d -exec chmod 2750 {} +
  find "$DATA/pbx" -type f -exec chmod 0640 {} +
  [ -f "$DATA/pbx/tls/kiestoon.crt" ] && chmod 0644 "$DATA/pbx/tls/kiestoon.crt"

  install -d -o asterisk -g asterisk -m 2770 "$DATA/asterisk" "$DATA/asterisk/spool" "$DATA/asterisk/spool/monitor"
  chown -R asterisk:asterisk "$DATA/asterisk"
  find "$DATA/asterisk" -type d -exec chmod 2770 {} +
  find "$DATA/asterisk" -type f -exec chmod 0660 {} +
  install -d -o kiestoon -g asterisk -m 2750 "$DATA/pbx/prompts"

  install -d -o asterisk -g kiestoon -m 2770 "$DATA/mailq"
  chown -R asterisk:kiestoon "$DATA/mailq"
  find "$DATA/mailq" -type f -exec chmod 0660 {} +
fi
exit 0
