<configuration name="callcenter.conf" description="CallCenter">
  <queues>
    <queue name="support@default">
      <param name="strategy" value="longest-idle-agent"/>
      <param name="max-wait-time" value="300"/>
    </queue>
  </queues>
  <agents>
    <agent name="1000@default" type="callback" contact="[call_timeout=10]user/1000@default" status="Available"/>
    <agent name="1001@default" type="callback" contact="user/1001@default"/>
  </agents>
  <tiers>
    <tier agent="1000@default" queue="support@default" level="1" position="1"/>
    <tier agent="1001@default" queue="support@default" level="1" position="2"/>
  </tiers>
</configuration>
