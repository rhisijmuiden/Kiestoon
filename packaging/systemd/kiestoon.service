[Unit]
Description=Kiestoon phone system portal
Documentation=https://github.com/rhisijmuiden/kiestoon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiestoon
Group=kiestoon
# Reads and manages voicemail, recordings and greetings in the Asterisk spool.
SupplementaryGroups=asterisk
EnvironmentFile=/etc/kiestoon/kiestoon.env
ExecStart=/usr/bin/kiestoon serve
Restart=on-failure
RestartSec=3

# Hardening: the portal only needs its data directory and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only to listen on the standard LDAP ports (389/636) for the phone book.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027
ReadWritePaths=/var/lib/kiestoon

[Install]
WantedBy=multi-user.target
