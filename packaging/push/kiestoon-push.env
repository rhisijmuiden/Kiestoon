# Kiestoon push relay. Put an HTTPS proxy (Caddy) in front: push.example.com -> 127.0.0.1:8095.
KIESTOON_PUSH_LISTEN=127.0.0.1:8095
KIESTOON_PUSH_SECRET_FILE=/var/lib/kiestoon-push/secret

# Apple: a token signing key (.p8) from developer.apple.com > Keys, with Apple Push Notifications.
# Copy it to /etc/kiestoon-push/apns.p8 (chgrp kiestoon-push, chmod 0640).
#KIESTOON_PUSH_APNS_KEY=/etc/kiestoon-push/apns.p8
#KIESTOON_PUSH_APNS_KEY_ID=
#KIESTOON_PUSH_APNS_TEAM_ID=
#KIESTOON_PUSH_APNS_BUNDLE=nl.rhis.kiestoon

# Google: a service account key (JSON) of the Firebase project, copied to /etc/kiestoon-push/fcm.json
# (chgrp kiestoon-push, chmod 0640).
#KIESTOON_PUSH_FCM_CREDENTIALS=/etc/kiestoon-push/fcm.json

# Without keys: only log (for a test setup).
KIESTOON_PUSH_LOG_ONLY=1
