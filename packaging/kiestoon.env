# Kiestoon settings. Restart after a change: systemctl restart kiestoon

# Address of the web portal.
KIESTOON_LISTEN=:8080

# Database, uploads and pre-update backups. Keep all state here, so a backup of this folder is complete.
KIESTOON_DATA_DIR=/var/lib/kiestoon

# GitHub repository for releases and updates.
KIESTOON_REPO=rhisijmuiden/kiestoon

# Update channel to start with: production or testing. Admins can change it in the portal (Info & updates).
KIESTOON_CHANNEL=production

# Set to true when the portal is served over HTTPS (for example behind Caddy).
KIESTOON_SECURE_COOKIES=false
